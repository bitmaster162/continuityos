{
  "$id": "continuityos.merge_execution.base_branch_readback/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "branch": {
      "type": "string"
    },
    "head": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "provider": {
      "const": "GITHUB"
    },
    "read_at_utc": {
      "type": "string"
    },
    "readback": {
      "type": "boolean"
    },
    "repository": {
      "type": "string"
    },
    "schema": {
      "const": "continuityos.merge_execution.base_branch_readback/v1"
    },
    "tree": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "visibility": {
      "enum": [
        "PRIVATE",
        "PUBLIC"
      ]
    }
  },
  "required": [
    "schema",
    "provider",
    "readback",
    "repository",
    "branch",
    "head",
    "tree",
    "visibility",
    "read_at_utc"
