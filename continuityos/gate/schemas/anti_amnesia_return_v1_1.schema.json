{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ANTI_AMNESIA_RETURN_V1_1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "gate",
    "mode",
    "boot_receipt",
    "boot_binding",
    "work_order_binding",
    "terminal_state",
    "continuity_capsule",
    "proposed_delta",
    "effects",
    "git",
    "artifacts",
    "tests"
  ],
  "properties": {
    "schema": {"const": "ANTI_AMNESIA_RETURN_V1_1"},
    "gate": {"const": "ANTI_AMNESIA_GATE_V1"},
    "mode": {"const": "SHADOW"},
    "boot_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "boot_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context_digest",
        "r63_pointer_sha256",
        "role",
        "case_id",
        "case_binding"
      ],
      "properties": {
        "context_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "r63_pointer_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "role": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{0,63}$"},
        "case_id": {
          "anyOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}
          ]
        },
        "case_binding": {"enum": ["NOT_REQUESTED", "EXACT_STRUCTURED_MATCH"]}
      }
    },
    "work_order_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "body_sha256",
        "task_class",
        "base_state_sha256",
        "permission_policy_sha256"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "body_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "task_class": {
          "enum": ["IMPLEMENTATION", "RESEARCH", "AUDIT", "TRANSPORT", "CONTENT", "OTHER"]
        },
        "base_state_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "permission_policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "terminal_state": {"type": "string", "minLength": 1},
    "continuity_capsule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_digest",
        "drift_risks",
        "unresolved",
        "next_action",
        "stop_condition"
      ],
      "properties": {
        "state_digest": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "drift_risks": {
          "type": "array",
          "items": {"type": "string"}
        },
        "unresolved": {
          "type": "array",
          "items": {"type": "string"}
        },
        "next_action": {"type": "string", "minLength": 1},
        "stop_condition": {"type": "string", "minLength": 1}
      }
    },
    "proposed_delta": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["op", "path"],
            "properties": {
              "op": {"const": "remove"},
              "path": {"type": "string", "pattern": "^(?:/(?:[^~/]|~0|~1)*)+$"}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["op", "path", "value"],
            "properties": {
              "op": {"enum": ["add", "replace"]},
              "path": {"type": "string", "pattern": "^(?:/(?:[^~/]|~0|~1)*)+$"},
              "value": {}
            }
          }
        ]
      }
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effect_class", "requested"],
      "properties": {
        "effect_class": {"enum": ["REVERSIBLE", "COMPENSATABLE", "IRREVERSIBLE"]},
        "requested": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "live_state_apply",
            "push",
            "deploy",
            "external_message",
            "credential_rotation",
            "service_mutation",
            "scheduler_mutation",
            "trading",
            "can_trade",
            "capital_permission"
          ],
          "properties": {
            "live_state_apply": {"type": "boolean"},
            "push": {"type": "boolean"},
            "deploy": {"type": "boolean"},
            "external_message": {"type": "boolean"},
            "credential_rotation": {"type": "boolean"},
            "service_mutation": {"type": "boolean"},
            "scheduler_mutation": {"type": "boolean"},
            "trading": {"type": "boolean"},
            "can_trade": {"type": "boolean"},
            "capital_permission": {"enum": ["DENY", "REQUEST"]}
          }
        }
      }
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "bundle_artifact",
        "branch",
        "baseline_head",
        "baseline_tree",
        "final_head",
        "final_tree",
        "diff_paths"
      ],
      "properties": {
        "required": {"type": "boolean"},
        "bundle_artifact": {"type": ["string", "null"]},
        "branch": {"type": ["string", "null"]},
        "baseline_head": {
          "anyOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^[0-9a-f]{40}$"}
          ]
        },
        "baseline_tree": {
          "anyOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^[0-9a-f]{40}$"}
          ]
        },
        "final_head": {
          "anyOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^[0-9a-f]{40}$"}
          ]
        },
        "final_tree": {
          "anyOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^[0-9a-f]{40}$"}
          ]
        },
        "diff_paths": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "path", "old_path"],
            "properties": {
              "status": {"type": "string", "pattern": "^(?:A|M|D|T|U|X|B|R[0-9]{1,3}|C[0-9]{1,3})$"},
              "path": {"type": "string", "minLength": 1},
              "old_path": {"type": ["string", "null"]}
            }
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size_bytes", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "size_bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "result", "passed", "failed", "skipped", "evidence"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "result": {"enum": ["PASS", "FAIL", "SKIP"]},
          "passed": {"type": "integer", "minimum": 0},
          "failed": {"type": "integer", "minimum": 0},
          "skipped": {"type": "integer", "minimum": 0},
          "evidence": {"type": ["string", "null"]}
        }
      }
    }
  }
}
