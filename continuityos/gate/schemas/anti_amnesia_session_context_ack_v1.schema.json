{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "accepted_truth_owner": {
      "const": "CONTROL_CENTER",
      "type": "string"
    },
    "active_case": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "minLength": 1,
          "type": "string"
        }
      ]
    },
    "authority_generation": {
      "const": "R63",
      "type": "string"
    },
    "baseline_head": {
      "pattern": "^[0-9a-f]{40,64}$",
      "type": "string"
    },
    "baseline_tree": {
      "pattern": "^[0-9a-f]{40,64}$",
      "type": "string"
    },
    "binding_id": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "can_trade": {
      "const": false,
      "type": "boolean"
    },
    "capital_permission": {
      "const": "DENY",
      "type": "string"
    },
    "challenge_id": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "checkpoint_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "checkpoint_id": {
      "minLength": 1,
      "type": "string"
    },
    "content_acceptance": {
      "const": "NOT_PERFORMED",
      "type": "string"
    },
    "context_event_cursor": {
      "minimum": 0,
      "type": "integer"
    },
    "context_is_projection_only": {
      "const": true,
      "type": "boolean"
    },
    "context_projection_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "context_spec_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "context_verification_receipt_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "deploy_permission": {
      "const": "DENY",
      "type": "string"
    },
    "effect_ceiling": {
      "const": "READ_ONLY",
      "type": "string"
    },
    "may_dispatch_codex": {
      "const": false,
      "type": "boolean"
    },
    "operational_context_file_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "operational_context_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "role": {
      "minLength": 1,
      "type": "string"
    },
    "schema": {
      "const": "ANTI_AMNESIA_SESSION_CONTEXT_ACK_V1",
      "type": "string"
    },
    "self_application": {
      "const": false,
      "type": "boolean"
    },
    "session_capsule_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "session_input_manifest_file_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "session_input_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "state_apply": {
      "const": "DISABLED",
      "type": "string"
    },
    "work_order_id": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema",
    "binding_id",
    "challenge_id",
    "authority_generation",
    "role",
    "active_case",
    "work_order_id",
    "baseline_head",
    "baseline_tree",
    "effect_ceiling",
    "session_input_manifest_file_sha256",
    "session_input_manifest_sha256",
    "session_capsule_sha256",
    "operational_context_file_sha256",
    "operational_context_sha256",
    "context_spec_sha256",
    "context_verification_receipt_sha256",
    "checkpoint_id",
    "checkpoint_hash",
    "context_event_cursor",
    "context_projection_sha256",
    "accepted_truth_owner",
    "context_is_projection_only",
    "content_acceptance",
    "state_apply",
    "may_dispatch_codex",
    "can_trade",
    "capital_permission",
    "deploy_permission",
    "self_application"
  ],
  "title": "Anti-Amnesia Session Context ACK v1",
  "type": "object"
}
