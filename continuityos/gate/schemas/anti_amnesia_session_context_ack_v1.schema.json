{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ANTI_AMNESIA_SESSION_CONTEXT_ACK_V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "binding_id",
    "challenge_id",
    "authority_generation",
    "role",
    "active_case",
    "work_order_id",
    "session_capsule_sha256",
    "operational_context_file_sha256",
    "operational_context_sha256",
    "checkpoint_id",
    "checkpoint_hash",
    "context_event_cursor",
    "context_projection_sha256",
    "selection_spec_sha256",
    "accepted_truth_owner",
    "context_is_projection_only",
    "content_acceptance",
    "state_apply",
    "may_dispatch_codex",
    "can_trade",
    "capital_permission",
    "deploy_permission",
    "self_application"
  ],
  "properties": {
    "schema": {"const": "ANTI_AMNESIA_SESSION_CONTEXT_ACK_V1"},
    "binding_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "challenge_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authority_generation": {"const": "R63"},
    "role": {"type": "string", "minLength": 1},
    "active_case": {"type": ["string", "null"]},
    "work_order_id": {"type": "string", "minLength": 1},
    "session_capsule_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "operational_context_file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "operational_context_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "checkpoint_id": {"type": "string", "minLength": 1},
    "checkpoint_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "context_event_cursor": {"type": "integer", "minimum": 0},
    "context_projection_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "selection_spec_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "accepted_truth_owner": {"const": "CONTROL_CENTER"},
    "context_is_projection_only": {"const": true},
    "content_acceptance": {"const": "NOT_PERFORMED"},
    "state_apply": {"const": "DISABLED"},
    "may_dispatch_codex": {"const": false},
    "can_trade": {"const": false},
    "capital_permission": {"const": "DENY"},
    "deploy_permission": {"const": "DENY"},
    "self_application": {"const": false}
  }
}
