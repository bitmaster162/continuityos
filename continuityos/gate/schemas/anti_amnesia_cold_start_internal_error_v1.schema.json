{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ANTI_AMNESIA_COLD_START_INTERNAL_ERROR_V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "gate", "mode", "command", "error_type", "error", "outcome",
    "status", "release_blocked", "live_state_modified", "writes_performed",
    "can_trade", "capital_permission"
  ],
  "properties": {
    "schema": {"const": "ANTI_AMNESIA_COLD_START_INTERNAL_ERROR_V1"},
    "gate": {"const": "ANTI_AMNESIA_GATE_V1"},
    "mode": {"const": "SHADOW"},
    "command": {"type": "string", "pattern": "^cold-start (prepare|verify|unknown)$"},
    "error_type": {"type": "string", "minLength": 1},
    "error": {"type": "string"},
    "outcome": {"const": "FAIL"},
    "status": {"const": "COLD_START_FAIL"},
    "release_blocked": {"const": true},
    "live_state_modified": {"const": false},
    "writes_performed": {"type": "array", "maxItems": 0},
    "can_trade": {"const": false},
    "capital_permission": {"const": "DENY"}
  }
}
