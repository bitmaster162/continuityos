{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ANTI_AMNESIA_ROLE_PERMISSION_POLICY_V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "authority_generation", "policy_id", "roles"],
  "properties": {
    "schema": {"const": "ANTI_AMNESIA_ROLE_PERMISSION_POLICY_V1"},
    "authority_generation": {"const": "R63"},
    "policy_id": {"type": "string", "minLength": 1},
    "roles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "allow_no_case",
          "allowed_delta_prefixes",
          "allowed_git_paths",
          "allowed_effect_classes"
        ],
        "properties": {
          "allow_no_case": {"type": "boolean"},
          "allowed_delta_prefixes": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^/(?:[^~/]|~0|~1)*(?:/(?:[^~/]|~0|~1)*)*$"}
          },
          "allowed_git_paths": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "allowed_effect_classes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["REVERSIBLE", "COMPENSATABLE", "IRREVERSIBLE"]}
          }
        }
      }
    }
  }
}
