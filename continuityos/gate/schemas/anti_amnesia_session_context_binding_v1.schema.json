{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ANTI_AMNESIA_SESSION_CONTEXT_BINDING_V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "binding_id",
    "gate",
    "mode",
    "authority_generation",
    "base_challenge",
    "session",
    "session_capsule",
    "operational_context",
    "ceilings"
  ],
  "properties": {
    "schema": {"const": "ANTI_AMNESIA_SESSION_CONTEXT_BINDING_V1"},
    "binding_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gate": {"const": "ANTI_AMNESIA_GATE_V1"},
    "mode": {"const": "SHADOW"},
    "authority_generation": {"const": "R63"},
    "base_challenge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["challenge_id", "sha256"],
      "properties": {
        "challenge_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "active_case", "work_order_id"],
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "active_case": {"type": ["string", "null"]},
        "work_order_id": {"type": "string", "minLength": 1}
      }
    },
    "session_capsule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256"],
      "properties": {
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "operational_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "file_sha256",
        "context_sha256",
        "checkpoint_id",
        "checkpoint_hash",
        "event_cursor",
        "event_chain_head",
        "projection_sha256",
        "selection_spec_sha256"
      ],
      "properties": {
        "schema": {"const": "CONTINUITYOS_OPERATIONAL_CONTEXT_PACK_V1"},
        "file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "context_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "checkpoint_id": {"type": "string", "minLength": 1},
        "checkpoint_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "event_cursor": {"type": "integer", "minimum": 0},
        "event_chain_head": {
          "anyOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          ]
        },
        "projection_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "selection_spec_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "ceilings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepted_truth_owner",
        "context_is_projection_only",
        "content_acceptance",
        "state_apply",
        "may_dispatch_codex",
        "can_trade",
        "capital_permission",
        "deploy_permission",
        "self_application"
      ],
      "properties": {
        "accepted_truth_owner": {"const": "CONTROL_CENTER"},
        "context_is_projection_only": {"const": true},
        "content_acceptance": {"const": "NOT_PERFORMED"},
        "state_apply": {"const": "DISABLED"},
        "may_dispatch_codex": {"const": false},
        "can_trade": {"const": false},
        "capital_permission": {"const": "DENY"},
        "deploy_permission": {"const": "DENY"},
        "self_application": {"const": false}
      }
    }
  }
}
