{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "continuityos.causal_spine.event/v1",
  "title": "ContinuityOS Causal Spine Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "sequence", "event_type", "recorded_at_utc", "actor", "spine_id", "subject_type", "subject_id", "spine_sha256", "result", "prev_event_sha256", "effects", "event_sha256"],
  "properties": {
    "schema": {"const": "continuityos.causal_spine.event/v1"},
    "sequence": {"type": "integer", "minimum": 0},
    "event_type": {"const": "CAUSAL_SPINE_EVALUATED"},
    "recorded_at_utc": {"type": "string", "format": "date-time"},
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "id"],
      "properties": {
        "role": {"const": "CAUSAL_SPINE_GATE"},
        "id": {"type": "string", "minLength": 1}
      }
    },
    "spine_id": {"type": "string", "minLength": 1},
    "subject_type": {"type": "string", "minLength": 1},
    "subject_id": {"type": "string", "minLength": 1},
    "spine_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "result": {"type": "object"},
    "prev_event_sha256": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9a-f]{64}$"}]},
    "effects": {"type": "object"},
    "event_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
