{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://continuityos.dev/schemas/causal_spine_v1.schema.json",
  "title": "ContinuityOS Causal Spine v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["spine_id", "subject_type", "subject_id", "pivot_status", "contradicted", "superseded"],
  "properties": {
    "spine_id": {"type": "string", "minLength": 1},
    "subject_type": {"type": "string", "minLength": 1},
    "subject_id": {"type": "string", "minLength": 1},
    "origin": {"$ref": "#/$defs/frontier"},
    "pivot_status": {"enum": ["FOUND", "NO_MATERIAL_PIVOT_FOUND", "SEARCH_INCOMPLETE", "UNKNOWN"]},
    "pivot": {"$ref": "#/$defs/frontier"},
    "pivot_search": {"$ref": "#/$defs/bounded_search"},
    "current_state": {"$ref": "#/$defs/current_state"},
    "contradicted": {"type": "boolean"},
    "superseded": {"type": "boolean"}
  },
  "$defs": {
    "evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_system", "object_id"],
      "properties": {
        "source_system": {"type": "string", "minLength": 1},
        "object_id": {"type": "string", "minLength": 1},
        "revision_id": {"type": ["string", "null"]},
        "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-fA-F]{64}$"},
        "locator": {"type": ["string", "null"]}
      },
      "anyOf": [
        {"required": ["revision_id"], "properties": {"revision_id": {"type": "string", "minLength": 1}}},
        {"required": ["sha256"], "properties": {"sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}}}
      ]
    },
    "frontier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "evidence"],
      "properties": {
        "event_id": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence_ref"}}
      }
    },
    "bounded_search": {
      "type": "object",
      "additionalProperties": false,
      "required": ["search_id", "scope", "sources_checked", "completed"],
      "properties": {
        "search_id": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1},
        "sources_checked": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence_ref"}},
        "completed": {"type": "boolean"}
      }
    },
    "current_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "state_id", "observed_at", "evidence"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "state_id": {"type": "string", "minLength": 1},
        "observed_at": {"type": "string", "format": "date-time"},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence_ref"}}
      }
    }
  }
}
