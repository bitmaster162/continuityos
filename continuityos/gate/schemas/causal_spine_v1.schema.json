{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "continuityos.causal_spine/v1",
  "title": "ContinuityOS Causal Spine v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "spine_id",
    "subject_type",
    "subject_id",
    "origin",
    "pivot_status",
    "pivot",
    "pivot_search",
    "current_state",
    "contradicted",
    "contradiction_evidence",
    "superseded",
    "superseded_by"
  ],
  "properties": {
    "schema": {"const": "continuityos.causal_spine/v1"},
    "spine_id": {"type": "string", "minLength": 1},
    "subject_type": {"type": "string", "minLength": 1},
    "subject_id": {"type": "string", "minLength": 1},
    "origin": {"oneOf": [{"$ref": "#/$defs/frontier"}, {"type": "null"}]},
    "pivot_status": {"enum": ["FOUND", "NO_MATERIAL_PIVOT_FOUND", "SEARCH_INCOMPLETE", "UNKNOWN"]},
    "pivot": {"oneOf": [{"$ref": "#/$defs/frontier"}, {"type": "null"}]},
    "pivot_search": {"oneOf": [{"$ref": "#/$defs/bounded_search"}, {"type": "null"}]},
    "current_state": {"oneOf": [{"$ref": "#/$defs/current_state"}, {"type": "null"}]},
    "contradicted": {"type": "boolean"},
    "contradiction_evidence": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/evidence_ref"}},
    "superseded": {"type": "boolean"},
    "superseded_by": {"oneOf": [{"$ref": "#/$defs/evidence_ref"}, {"type": "null"}]}
  },
  "$defs": {
    "evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_system", "object_id", "revision_id", "sha256", "locator"],
      "properties": {
        "source_system": {"type": "string", "minLength": 1},
        "object_id": {"type": "string", "minLength": 1},
        "revision_id": {"type": ["string", "null"], "minLength": 1},
        "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "locator": {"type": ["string", "null"], "minLength": 1}
      },
      "anyOf": [
        {"properties": {"revision_id": {"type": "string", "minLength": 1}}},
        {"properties": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}
      ]
    },
    "frontier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "evidence"],
      "properties": {
        "event_id": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/evidence_ref"}}
      }
    },
    "bounded_search": {
      "type": "object",
      "additionalProperties": false,
      "required": ["search_id", "scope", "sources_checked", "completed", "completed_at"],
      "properties": {
        "search_id": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1},
        "sources_checked": {"type": "array", "minItems": 1, "maxItems": 1024, "items": {"$ref": "#/$defs/evidence_ref"}},
        "completed": {"type": "boolean"},
        "completed_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "current_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "state_id", "observed_at", "evidence", "resolution_artifact_id", "resolution_artifact_sha256"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "state_id": {"type": "string", "minLength": 1},
        "observed_at": {"type": "string", "format": "date-time"},
        "evidence": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/evidence_ref"}},
        "resolution_artifact_id": {"type": "string", "minLength": 1},
        "resolution_artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"contradicted": {"const": true}}, "required": ["contradicted"]},
      "then": {"properties": {"contradiction_evidence": {"minItems": 1}}}
    },
    {
      "if": {"properties": {"superseded": {"const": true}}, "required": ["superseded"]},
      "then": {"properties": {"superseded_by": {"$ref": "#/$defs/evidence_ref"}}}
    }
  ]
}
