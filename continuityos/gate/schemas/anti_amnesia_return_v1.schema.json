{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ANTI_AMNESIA_RETURN_V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "gate",
    "mode",
    "boot_receipt",
    "boot_binding",
    "terminal_state",
    "continuity_capsule",
    "work_delta",
    "product_delta",
    "effects",
    "artifacts",
    "tests"
  ],
  "properties": {
    "schema": {"type": "string", "enum": ["ANTI_AMNESIA_RETURN_V1"]},
    "gate": {"type": "string", "enum": ["ANTI_AMNESIA_GATE_V1"]},
    "mode": {"type": "string", "enum": ["SHADOW"]},
    "boot_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "boot_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context_digest",
        "r63_pointer_sha256",
        "role",
        "case_id",
        "case_binding"
      ],
      "properties": {
        "context_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "r63_pointer_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "role": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{0,63}$"},
        "case_id": {
          "anyOf": [
            {"type": "null"},
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            }
          ]
        },
        "case_binding": {
          "type": "string",
          "enum": [
            "NOT_REQUESTED",
            "EXACT_STRUCTURED_MATCH",
            "CLI_ASSERTED_NON_AUTHORITY"
          ]
        }
      }
    },
    "terminal_state": {"type": "string", "minLength": 1},
    "continuity_capsule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_digest",
        "drift_risks",
        "top_open_loops",
        "next_irreversible_action",
        "checkpoint_delta"
      ],
      "properties": {
        "state_digest": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "drift_risks": {
          "type": "array",
          "items": {"type": "string"}
        },
        "top_open_loops": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "status", "next_action"],
            "properties": {
              "id": {"type": "string"},
              "title": {"type": "string"},
              "status": {"type": "string"},
              "next_action": {"type": ["string", "null"]}
            }
          }
        },
        "next_irreversible_action": {"type": "string", "minLength": 1},
        "checkpoint_delta": {
          "type": "object",
          "additionalProperties": false,
          "required": ["action", "reference", "reason"],
          "properties": {
            "action": {
              "type": "string",
              "enum": ["NONE", "PROPOSED", "COMPLETED"]
            },
            "reference": {"type": ["string", "null"]},
            "reason": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "work_delta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "state_changes", "source_changes", "unknowns"],
      "properties": {
        "summary": {"type": "string", "minLength": 1},
        "state_changes": {"type": "array", "items": {"type": "string"}},
        "source_changes": {"type": "array", "items": {"type": "string"}},
        "unknowns": {"type": "array", "items": {"type": "string"}}
      }
    },
    "product_delta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence"],
      "properties": {
        "status": {"type": "string", "enum": ["ZERO", "NONZERO", "UNKNOWN"]},
        "evidence": {"type": "array", "items": {"type": "string"}}
      }
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "live_state_applied",
        "r63_authority_replaced",
        "return_registry_mutated",
        "checkpoint_created",
        "push",
        "deploy",
        "external_messages",
        "can_trade",
        "capital_permission"
      ],
      "properties": {
        "live_state_applied": {"type": "boolean", "enum": [false]},
        "r63_authority_replaced": {"type": "boolean", "enum": [false]},
        "return_registry_mutated": {"type": "boolean", "enum": [false]},
        "checkpoint_created": {"type": "boolean", "enum": [false]},
        "push": {"type": "boolean", "enum": [false]},
        "deploy": {"type": "boolean", "enum": [false]},
        "external_messages": {"type": "boolean", "enum": [false]},
        "can_trade": {"type": "boolean", "enum": [false]},
        "capital_permission": {"type": "string", "enum": ["DENY"]}
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size_bytes", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "size_bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "contains": {
        "type": "object",
        "required": ["result", "evidence"],
        "properties": {
          "result": {"type": "string", "enum": ["PASS"]},
          "evidence": {"type": "string", "minLength": 1}
        }
      },
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "result",
          "passed",
          "failed",
          "skipped",
          "evidence"
        ],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "result": {"type": "string", "enum": ["PASS", "FAIL", "SKIP"]},
          "passed": {"type": "integer", "minimum": 0},
          "failed": {"type": "integer", "minimum": 0},
          "skipped": {"type": "integer", "minimum": 0},
          "evidence": {"type": ["string", "null"]}
        }
      }
    }
  }
}
