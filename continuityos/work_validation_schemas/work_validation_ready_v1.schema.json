{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "continuityos.work_validation.ready/v1",
  "type": "object",
  "required": [
    "schema", "created_at_utc", "status", "validation_receipt_sha256",
    "manifest_sha256", "candidate_head", "candidate_tree", "written_last"
  ],
  "properties": {
    "schema": {"const": "continuityos.work_validation.ready/v1"},
    "created_at_utc": {"type": "string"},
    "status": {
      "enum": [
        "WORK_VALIDATION_EXECUTION_PASS",
        "WORK_VALIDATION_EXECUTION_HOLD",
        "WORK_VALIDATION_EXECUTION_REVISE"
      ]
    },
    "validation_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "candidate_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "written_last": {"const": true}
  },
  "additionalProperties": false
}
