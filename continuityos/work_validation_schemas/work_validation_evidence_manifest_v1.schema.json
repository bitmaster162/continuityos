{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "continuityos.work_validation.evidence_manifest/v1",
  "type": "object",
  "required": ["schema", "created_at_utc", "files"],
  "properties": {
    "schema": {"const": "continuityos.work_validation.evidence_manifest/v1"},
    "created_at_utc": {"type": "string"},
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": {"type": "string"},
          "bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
