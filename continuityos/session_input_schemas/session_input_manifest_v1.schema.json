{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ANTI_AMNESIA_SESSION_INPUT_MANIFEST_V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "authority_generation",
    "session_binding",
    "artifact_binding",
    "memory_binding",
    "ceilings",
    "manifest_sha256"
  ],
  "properties": {
    "schema": {"const": "ANTI_AMNESIA_SESSION_INPUT_MANIFEST_V1"},
    "authority_generation": {"const": "R63"},
    "session_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "challenge_id",
        "current_pointer_sha256",
        "workspace_context_digest",
        "role",
        "active_case",
        "case_binding",
        "work_order_id",
        "git_repository",
        "git_branch",
        "git_head",
        "git_tree"
      ],
      "properties": {
        "challenge_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "current_pointer_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "workspace_context_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "role": {"type": "string", "minLength": 1},
        "active_case": {"type": ["string", "null"]},
        "case_binding": {"enum": ["NOT_REQUESTED", "EXACT_STRUCTURED_MATCH"]},
        "work_order_id": {"type": "string", "minLength": 1},
        "git_repository": {"type": "string", "minLength": 1},
        "git_branch": {"type": "string", "minLength": 1},
        "git_head": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
        "git_tree": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"}
      }
    },
    "artifact_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_capsule", "operational_context", "context_spec"],
      "properties": {
        "session_capsule": {
          "type": "object",
          "additionalProperties": false,
          "required": ["logical_name", "sha256"],
          "properties": {
            "logical_name": {"const": "SESSION_CAPSULE.json"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "operational_context": {
          "type": "object",
          "additionalProperties": false,
          "required": ["logical_name", "file_sha256", "context_sha256"],
          "properties": {
            "logical_name": {"const": "OPERATIONAL_CONTEXT.json"},
            "file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "context_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "context_spec": {
          "type": "object",
          "additionalProperties": false,
          "required": ["logical_name", "sha256"],
          "properties": {
            "logical_name": {"const": "OPERATIONAL_CONTEXT_SPEC.json"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        }
      }
    },
    "memory_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "database_identity_sha256",
        "checkpoint_id",
        "checkpoint_hash",
        "event_cursor",
        "event_chain_head",
        "projection_sha256",
        "valid_at"
      ],
      "properties": {
        "database_identity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "checkpoint_id": {"type": "string", "minLength": 1},
        "checkpoint_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "event_cursor": {"type": "integer", "minimum": 0},
        "event_chain_head": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "projection_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "valid_at": {"type": ["string", "null"]}
      }
    },
    "ceilings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effect_ceiling",
        "accepted_truth_owner",
        "context_is_projection_only",
        "content_acceptance",
        "state_apply",
        "may_dispatch_codex",
        "can_trade",
        "capital_permission",
        "deploy_permission",
        "self_application"
      ],
      "properties": {
        "effect_ceiling": {"const": "READ_ONLY"},
        "accepted_truth_owner": {"const": "CONTROL_CENTER"},
        "context_is_projection_only": {"const": true},
        "content_acceptance": {"const": "NOT_PERFORMED"},
        "state_apply": {"const": "DISABLED"},
        "may_dispatch_codex": {"const": false},
        "can_trade": {"const": false},
        "capital_permission": {"const": "DENY"},
        "deploy_permission": {"const": "DENY"},
        "self_application": {"const": false}
      }
    },
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
