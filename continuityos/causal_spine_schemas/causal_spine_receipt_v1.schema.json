{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "continuityos.causal_spine.receipt/v1",
  "title": "ContinuityOS Causal Spine Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "terminal",
    "status",
    "reason_code",
    "missing_frontiers",
    "causal_gate_passed",
    "state_resolution_terminal",
    "grants_source_authority",
    "grants_canonical_authority",
    "grants_merge_authority",
    "grants_deploy_authority",
    "grants_runtime_authority",
    "grants_effect_authority",
    "effects"
  ],
  "properties": {
    "schema": {"const": "continuityos.causal_spine.receipt/v1"},
    "terminal": {"enum": ["CAUSAL_SPINE_PASS", "CAUSAL_SPINE_INCOMPLETE"]},
    "status": {"enum": ["COMPLETE", "INCOMPLETE_ORIGIN", "INCOMPLETE_PIVOT", "INCOMPLETE_CURRENT_STATE", "SEARCH_INCOMPLETE", "CONTRADICTED", "SUPERSEDED"]},
    "reason_code": {"type": "string", "minLength": 1},
    "missing_frontiers": {"type": "array", "maxItems": 16, "items": {"type": "string", "minLength": 1}},
    "causal_gate_passed": {"type": "boolean"},
    "state_resolution_terminal": {"type": ["string", "null"]},
    "grants_source_authority": {"const": false},
    "grants_canonical_authority": {"const": false},
    "grants_merge_authority": {"const": false},
    "grants_deploy_authority": {"const": false},
    "grants_runtime_authority": {"const": false},
    "grants_effect_authority": {"const": false},
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["force_push", "merge", "pull_request_merge", "auto_merge", "deployment", "registry_apply", "current_state_apply", "r63_apply", "trading", "wallet_access", "order_execution", "external_message", "self_application", "can_trade", "capital_permission", "deploy_permission"],
      "properties": {
        "force_push": {"const": false},
        "merge": {"const": false},
        "pull_request_merge": {"const": false},
        "auto_merge": {"const": false},
        "deployment": {"const": false},
        "registry_apply": {"const": false},
        "current_state_apply": {"const": false},
        "r63_apply": {"const": false},
        "trading": {"const": false},
        "wallet_access": {"const": false},
        "order_execution": {"const": false},
        "external_message": {"const": false},
        "self_application": {"const": false},
        "can_trade": {"const": false},
        "capital_permission": {"const": "DENY"},
        "deploy_permission": {"const": "DENY"}
      }
    }
  }
}
